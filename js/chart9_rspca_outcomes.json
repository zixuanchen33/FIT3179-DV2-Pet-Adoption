{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 260,

  "data": {
    "url": "data/rspca_state_2024_25.csv"
  },

  "transform": [
    {
      "calculate": "datum.dog_total - datum.dog_rehomed - datum.dog_euthanased - datum.dog_in_care",
      "as": "dog_other"
    },
    {
      "calculate": "datum.cat_total - datum.cat_rehomed - datum.cat_euthanased - datum.cat_in_care",
      "as": "cat_other"
    },
    {
      "fold": [
        "dog_rehomed",
        "dog_euthanased",
        "dog_in_care",
        "dog_other",
        "cat_rehomed",
        "cat_euthanased",
        "cat_in_care",
        "cat_other"
      ],
      "as": [
        "outcome_field",
        "count"
      ]
    },
    {
      "calculate": "indexof(datum.outcome_field, 'dog_') === 0 ? 'Dogs' : 'Cats'",
      "as": "species"
    },
    {
      "calculate": "indexof(datum.outcome_field, 'rehomed') >= 0 ? 'Rehomed' : indexof(datum.outcome_field, 'euthanased') >= 0 ? 'Euthanased' : indexof(datum.outcome_field, 'in_care') >= 0 ? 'Still in care' : 'Other outcomes'",
      "as": "outcome"
    },
    {
      "calculate": "datum.outcome === 'Rehomed' ? 1 : datum.outcome === 'Still in care' ? 2 : datum.outcome === 'Euthanased' ? 3 : 4",
      "as": "outcome_order"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "outcome_count"
        }
      ],
      "groupby": [
        "species",
        "outcome",
        "outcome_order"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "outcome_count",
          "as": "species_total"
        }
      ],
      "groupby": [
        "species"
      ]
    },
    {
      "calculate": "datum.outcome_count / datum.species_total",
      "as": "outcome_share"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadius": 3
  },

  "encoding": {
    "y": {
      "field": "species",
      "type": "nominal",
      "title": null,
      "sort": [
        "Cats",
        "Dogs"
      ],
      "axis": {
        "labelFontSize": 14,
        "labelFontWeight": "bold"
      }
    },

    "x": {
      "field": "outcome_count",
      "type": "quantitative",
      "title": "Share of animals",
      "stack": "normalize",
      "axis": {
        "format": ".0%",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "grid": false
      }
    },

    "color": {
      "field": "outcome",
      "type": "nominal",
      "title": "Outcome",
      "scale": {
        "domain": [
          "Rehomed",
          "Still in care",
          "Euthanased",
          "Other outcomes"
        ],
        "range": [
          "#657a58",
          "#d6b56f",
          "#b9665c",
          "#b8b8b8"
        ]
      }
    },

    "order": {
      "field": "outcome_order",
      "type": "quantitative",
      "sort": "ascending"
    },

    "tooltip": [
      {
        "field": "species",
        "type": "nominal",
        "title": "Species"
      },
      {
        "field": "outcome",
        "type": "nominal",
        "title": "Outcome"
      },
      {
        "field": "outcome_count",
        "type": "quantitative",
        "title": "Animals",
        "format": ",.0f"
      },
      {
        "field": "outcome_share",
        "type": "quantitative",
        "title": "Share",
        "format": ".1%"
      }
    ]
  },

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "labelFontSize": 12,
      "titleFontSize": 13
    },

    "axis": {
      "domain": false,
      "ticks": false
    }
  }
}