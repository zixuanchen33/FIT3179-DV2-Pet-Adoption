{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 480,

  "data": {
    "url": "data/petrescue_state_2025.csv"
  },

  "transform": [
    {
      "fold": [
        "cat_median_tta_days",
        "dog_median_tta_days"
      ],
      "as": [
        "species_field",
        "median_days"
      ]
    },
    {
      "calculate": "datum.species_field === 'cat_median_tta_days' ? 'Cats' : 'Dogs'",
      "as": "species"
    },
    {
      "calculate": "datum.state + ' — ' + datum.species",
      "as": "state_species"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 3,
        "opacity": 0.7
      },

      "encoding": {
        "y": {
          "field": "state_species",
          "type": "nominal",
          "title": null,
          "sort": [
            "ACT — Cats",
            "ACT — Dogs",
            "NSW — Cats",
            "NSW — Dogs",
            "NT — Cats",
            "NT — Dogs",
            "QLD — Cats",
            "QLD — Dogs",
            "SA — Cats",
            "SA — Dogs",
            "TAS — Cats",
            "TAS — Dogs",
            "VIC — Cats",
            "VIC — Dogs",
            "WA — Cats",
            "WA — Dogs"
          ],
          "axis": {
            "labelFontSize": 12
          }
        },

        "x": {
          "field": "median_days",
          "type": "quantitative",
          "title": "Median time to adoption (days)",
          "scale": {
            "domain": [
              0,
              55
            ]
          },
          "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "grid": true
          }
        },

        "color": {
          "field": "species",
          "type": "nominal",
          "title": "Species",
          "scale": {
            "domain": [
              "Cats",
              "Dogs"
            ],
            "range": [
              "#657a58",
              "#d28a5d"
            ]
          }
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 180,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },

      "encoding": {
        "y": {
          "field": "state_species",
          "type": "nominal",
          "title": null,
          "sort": [
            "ACT — Cats",
            "ACT — Dogs",
            "NSW — Cats",
            "NSW — Dogs",
            "NT — Cats",
            "NT — Dogs",
            "QLD — Cats",
            "QLD — Dogs",
            "SA — Cats",
            "SA — Dogs",
            "TAS — Cats",
            "TAS — Dogs",
            "VIC — Cats",
            "VIC — Dogs",
            "WA — Cats",
            "WA — Dogs"
          ]
        },

        "x": {
          "field": "median_days",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ]
          }
        },

        "color": {
          "field": "species",
          "type": "nominal",
          "title": "Species",
          "scale": {
            "domain": [
              "Cats",
              "Dogs"
            ],
            "range": [
              "#657a58",
              "#d28a5d"
            ]
          }
        },

        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "species",
            "type": "nominal",
            "title": "Species"
          },
          {
            "field": "median_days",
            "type": "quantitative",
            "title": "Median days to adoption",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'ACT' && datum.species === 'Cats'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -10,
        "dy": -5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#4f6145"
      },

      "encoding": {
        "y": {
          "field": "state_species",
          "type": "nominal",
          "sort": [
            "ACT — Cats",
            "ACT — Dogs",
            "NSW — Cats",
            "NSW — Dogs",
            "NT — Cats",
            "NT — Dogs",
            "QLD — Cats",
            "QLD — Dogs",
            "SA — Cats",
            "SA — Dogs",
            "TAS — Cats",
            "TAS — Dogs",
            "VIC — Cats",
            "VIC — Dogs",
            "WA — Cats",
            "WA — Dogs"
          ]
        },

        "x": {
          "field": "median_days",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ]
          }
        },

        "text": {
          "value": "Longest cat wait · 49.4 days"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state === 'SA' && datum.species === 'Dogs'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -10,
        "dy": -5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#a86545"
      },

      "encoding": {
        "y": {
          "field": "state_species",
          "type": "nominal",
          "sort": [
            "ACT — Cats",
            "ACT — Dogs",
            "NSW — Cats",
            "NSW — Dogs",
            "NT — Cats",
            "NT — Dogs",
            "QLD — Cats",
            "QLD — Dogs",
            "SA — Cats",
            "SA — Dogs",
            "TAS — Cats",
            "TAS — Dogs",
            "VIC — Cats",
            "VIC — Dogs",
            "WA — Cats",
            "WA — Dogs"
          ]
        },

        "x": {
          "field": "median_days",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ]
          }
        },

        "text": {
          "value": "Longest dog wait · 42.8 days"
        }
      }
    }
  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "labelFontSize": 12,
      "titleFontSize": 13
    },

    "axis": {
      "domainColor": "#b8b8b8",
      "tickColor": "#b8b8b8",
      "gridColor": "#eeeeee"
    }
  }
}